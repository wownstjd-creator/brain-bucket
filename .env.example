# Local scripts/run.ps1 settings (do not commit your actual .env)
DB_USERNAME=root
DB_PASSWORD=replace_with_your_own_password
DATABASE_URL=jdbc:mysql://localhost:3306/brain_bucket
COOKIE_SECURE=false
# Docker Compose uses its own brainbucket user and this separate root password.
MYSQL_ROOT_PASSWORD=replace_with_another_password

# HTTPS deployment only: public hostname without https://
DOMAIN=
